{
  "name": "fitness-studio-map-berlin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:py": "cd scripts && python3 -m unittest discover -s tests -v",
    "data:fetch": "cd scripts && python3 -m studiomap fetch",
    "data:apply": "cd scripts && python3 -m studiomap apply",
    "data:discard": "cd scripts && python3 -m studiomap discard",
    "data:rebuild": "cd scripts && python3 -m studiomap rebuild",
    "data:decide": "cd scripts && python3 -m studiomap decide",
    "data:validate": "cd scripts && python3 -m studiomap validate",
    "data:enrich-usc": "cd scripts && python3 -m studiomap enrich-usc",
    "data:enrich-wellpass": "cd scripts && python3 -m studiomap enrich-wellpass"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
